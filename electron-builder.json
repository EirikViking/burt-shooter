{
  "appId": "app.novaswarm.game",
  "productName": "Nova Swarm",
  "directories": {
    "output": "release/desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/discord-rpc/**/*",
    "node_modules/node-fetch/**/*",
    "node_modules/whatwg-url/**/*",
    "node_modules/tr46/**/*",
    "node_modules/webidl-conversions/**/*",
    "node_modules/steamworks-ffi-node/**/*",
    "node_modules/koffi/**/*",
    "steam_sdk/sdk/redistributable_bin/**/*",
    "steamworks_sdk/redistributable_bin/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/steamworks-ffi-node/**/*",
    "node_modules/koffi/**/*",
    "steam_sdk/sdk/redistributable_bin/**/*",
    "steamworks_sdk/redistributable_bin/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "build/icons/nova-swarm.ico",
    "executableName": "Nova Swarm",
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "asar": true,
  "compression": "maximum"
}
