{
  "appId": "app.novaswarm.game",
  "productName": "Nova Swarm",
  "directories": {
    "output": "release/desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/steamworks-ffi-node/**/*",
    "node_modules/koffi/**/*",
    "steam_sdk/sdk/redistributable_bin/**/*",
    "steamworks_sdk/redistributable_bin/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/steamworks-ffi-node/**/*",
    "node_modules/koffi/**/*",
    "steam_sdk/sdk/redistributable_bin/**/*",
    "steamworks_sdk/redistributable_bin/**/*"
  ],
  "extraFiles": [
    {
      "from": "steam_sdk/sdk/redistributable_bin/win64/steam_api64.dll",
      "to": "steam_api64.dll"
    },
    {
      "from": "steam_sdk/sdk/redistributable_bin/steam_api.dll",
      "to": "steam_api.dll"
    }
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "build/icons/nova-swarm.ico",
    "executableName": "Nova Swarm",
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "asar": true,
  "compression": "maximum"
}
