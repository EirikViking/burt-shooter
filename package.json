{
  "name": "nova-swarm",
  "version": "1.0.0",
  "description": "A polished arcade space shooter about dodging clever formations, chasing high scores, and roasting the swarm.",
  "author": "TinyFoundry",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/update-build.cjs && node scripts/check-ranks.cjs && node scripts/check-rankpolicy-parity.cjs && node scripts/check-sprite-catalog.cjs && node scripts/check-ship-traits.mjs && node scripts/check-audio-catalog.mjs",
    "build": "vite build",
    "check:ship-traits": "node scripts/check-ship-traits.mjs",
    "check:audio": "node scripts/check-audio-catalog.mjs",
    "check:provenance": "node scripts/check-asset-provenance.mjs",
    "check:desktop-package": "node scripts/check-desktop-package.mjs",
    "check:steam-assets": "node scripts/check-steam-assets.mjs",
    "check:steam-store": "node scripts/check-steam-store-metadata.mjs",
    "audit:release-readiness": "node scripts/audit-release-readiness.mjs",
    "verify:steam-rc": "node scripts/verify-steam-rc.mjs",
    "audit:audio-mix": "node scripts/audit-audio-mix.mjs --md docs/reviews/2026-05-17-audio-mix-audit.md --json docs/reviews/audio-mix-audit-2026-05-17.json",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-playtest.mjs",
    "playtest:release": "node scripts/release-playtest.mjs",
    "capture:steam-screenshots": "node scripts/capture-steam-screenshots.mjs",
    "capture:steam-trailer": "node scripts/capture-steam-trailer.mjs",
    "render:steam-trailer-audio": "node scripts/render-steam-trailer-audio.mjs",
    "render:steam-trailer-candidate": "node scripts/render-steam-trailer-candidate.mjs",
    "generate:nova-sfx": "node scripts/generate-nova-swarm-sfx.mjs",
    "steamworks:write-vdf": "node scripts/write-steamworks-vdf.mjs",
    "desktop:smoke": "npm run build && electron electron/main.cjs --smoke",
    "desktop:smoke:current": "electron electron/main.cjs --smoke",
    "package:steam:win": "npm run build && electron-builder --win dir --x64 --config electron-builder.json",
    "package:steam:win:current": "electron-builder --win dir --x64 --config electron-builder.json",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.0.11",
    "wrangler": "^4.59.1"
  }
}
